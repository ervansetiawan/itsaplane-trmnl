<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--medium lg:gap--large">
    <div class="flex flex--col flex--center shrink-0">
      <svg viewBox="0 0 360 360" class="w--[28cqw] h--[88cqh]">
        <rect x="2" y="2" width="356" height="356" rx="3" fill="#fff" stroke="#000" stroke-width="2" />
        <rect x="8" y="8" width="344" height="344" fill="none" stroke="#000" stroke-width="0.75" />
        {% for d in paths %}
          <path d="{{ d }}" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        {% endfor %}
      </svg>
    </div>

    <div class="divider--v portrait:hidden"></div>

    <div class="flex flex--col flex--between stretch-x h--full text--left">
      <div class="w--full">
        <span class="label label--small label--inverted px--2 rounded mb--1">{{ algorithm | upcase }}</span>
        <div class="title title--small text--left">{{ piece_title }}</div>
      </div>
      <div class="description text--left">{{ params }}</div>
      <div class="label label--small text--left value--tnums">SEED #{{ seed }} &middot; {{ stroke_count }} PATHS</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
