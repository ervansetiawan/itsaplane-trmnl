<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--large">
    <div class="flex flex--col flex--center shrink-0">
      <svg viewBox="0 0 360 360" class="w--[48cqw] h--[84cqh] portrait:w--[80cqw]">
        <rect x="2" y="2" width="356" height="356" fill="#fff" stroke="#000" stroke-width="2" />
        {% for d in paths %}
          <path d="{{ d }}" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        {% endfor %}
      </svg>
    </div>

    <div class="flex flex--col flex--between stretch-x h--full text--left">
      <div class="w--full">
        <div class="label label--base label--inverted px--2 mb--2">{{ algorithm | upcase }}</div>
        <div class="title title--base lg:title--large text--left mb--2">{{ piece_title }}</div>
        <div class="description text--left">{{ params }}</div>
      </div>

      <div class="w--full">
        <div class="divider mb--2"></div>
        <div class="label label--base text--left mb--1">SEED: #{{ seed }}</div>
        <div class="label label--small text--left">{{ stroke_count }} VECTOR PATHS &middot; 1-BIT PLOTTER</div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
