<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <div class="flex flex--col flex--center w--full stretch-y">
      <svg viewBox="0 0 360 360" class="w--[78cqw] h--[58cqh]">
        <rect x="2" y="2" width="356" height="356" fill="#fff" stroke="#000" stroke-width="2" />
        {% for d in paths %}
          <path d="{{ d }}" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        {% endfor %}
      </svg>
    </div>

    <div class="divider"></div>

    <div class="w--full text--left">
      <div class="title title--small text--left">{{ piece_title }}</div>
      <div class="description text--left">{{ algorithm }} &middot; {{ params }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
