<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--large">
    <div class="flex flex--col flex--center shrink-0">
      <svg viewBox="0 0 180 180" class="w--[42cqw] h--[82cqh] portrait:w--[66cqw]">
        <rect x="2" y="2" width="176" height="176" fill="#fff" stroke="#000" stroke-width="2.5" />
        <line x1="90" y1="2" x2="90" y2="178" stroke="#ccc" stroke-width="1" stroke-dasharray="3,3" />
        <line x1="2" y1="90" x2="178" y2="90" stroke="#ccc" stroke-width="1" stroke-dasharray="3,3" />
        <text x="90" y="132" font-size="122" font-weight="700" text-anchor="middle" fill="#000" font-family="serif">{{ kanji }}</text>
      </svg>
    </div>

    <div class="flex flex--col flex--between stretch-x h--full text--left">
      <div class="w--full">
        <div class="flex flex--row flex--between flex--center-y mb--2">
          <span class="label label--base label--inverted px--2">JLPT {{ jlpt }}</span>
          <span class="label label--base">{{ strokes }} STROKES</span>
        </div>
        <div class="title title--large text--left mb--2">{{ meaning }}</div>
        <div class="description text--left mb--1"><strong>On'yomi:</strong> {{ onyomi }}</div>
        <div class="description text--left mb--1"><strong>Kun'yomi:</strong> {{ kunyomi }}</div>
        <div class="description text--left"><strong>Radical:</strong> {{ radical }}</div>
      </div>

      <div class="w--full">
        <div class="divider mb--2"></div>
        <div class="label label--base label--underline mb--1 text--left">EXAMPLE</div>
        <div class="title title--small text--left mb--2">{{ example }}</div>

        {% if yesterday_kanji %}
          <div class="divider mb--2"></div>
          <div class="flex flex--row flex--between flex--center-y">
            <span class="label label--small">KANJI #{{ number }}</span>
            <span class="label label--base">Yesterday: <strong>{{ yesterday_kanji }}</strong> ({{ yesterday_meaning }})</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
