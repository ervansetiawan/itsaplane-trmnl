<div class="layout layout--col gap--small">
  <div class="flex flex--center w--full h--[64cqh] lg:portrait:h--[48cqh] shrink-0">
    <img src="{{ image_url }}" alt="{{ name }}" class="image image-dither image--contain w--full h--full rounded" />
  </div>

  <div class="stretch-x text--left">
    <div class="title title--small lg:title--large text--left">{{ name }}</div>
    <div class="label label--small lg:label--large text--left">{{ mobile_suit }}</div>
    <div class="hidden lg:portrait:block description lg:description--xlarge text--left mt--1">"{{ quote }}"</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ timeline }}</span>
</div>
