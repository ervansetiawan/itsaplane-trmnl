<div class="layout layout--row flex--top portrait:flex--col gap--medium lg:gap--large">
  <div class="flex flex--col shrink-0 w--[268px] lg:w--[280px] portrait:w--full gap--small">
    <div class="title title--small lg:title--base text--left w--full">{{ week_range }}</div>
    <div class="label label--small text--left w--full">{{ summary_line }}</div>

    <img src="{{ chart_png }}" alt="Weekly earnings density" class="image image--contain w--[264px] h--[186px] portrait:hidden" />
    <img src="{{ compact_png }}" alt="Weekly earnings density" class="image image--contain w--[256px] h--[130px] hidden portrait:block" />

    <div class="bg--gray-70 rounded p--2 w--full text--left">
      <div class="label label--small text--left w--full mb--1">MARQUEE REPORTERS</div>
      <div class="flex flex--col gap--xsmall w--full">
        {% for m in marquee limit: 3 %}
          <div class="flex flex--row flex--between flex--center-y w--full">
            <div class="flex flex--row flex--left flex--center-y gap--xsmall">
              <span class="label label--small label--inverted px--1">{{ m.symbol }}</span>
              <span class="label label--small">{{ m.day }} &middot; {{ m.slot }}</span>
            </div>
            <span class="label label--small">EPS {{ m.eps }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="divider--v portrait:hidden"></div>

  <div class="stretch-x text--left grow flex flex--col flex--top gap--xsmall">
    <div class="label label--small text--left w--full mb--1">MON–FRI BMO / AMC SCHEDULE</div>
    {% for d in days %}
      <div class="flex flex--row flex--between flex--center-y w--full border--b pb--1">
        <div class="flex flex--row flex--left flex--center-y gap--small shrink-0 w--[112px]">
          {% if d.is_today %}
            <span class="label label--small label--inverted px--2">{{ d.day }}</span>
          {% else %}
            <span class="label label--small label--outline px--2">{{ d.day }}</span>
          {% endif %}
          <span class="label label--small">{{ d.date_short }}</span>
        </div>

        <div class="flex flex--row flex--left flex--center-y gap--small grow">
          {% if d.top.size > 0 %}
            {% for item in d.top limit: 3 %}
              <span class="label label--small"><strong>{{ item.symbol }}</strong> ({{ item.slot }})</span>
            {% endfor %}
          {% else %}
            <span class="label label--small">Light calendar</span>
          {% endif %}
        </div>

        <span class="label label--small shrink-0">{{ d.total }} rpts</span>
      </div>
    {% endfor %}

    <div class="label label--small text--left w--full mt--1">CONSENSUS WATCHLIST DETAILS</div>
    <div class="flex flex--col gap--xsmall w--full">
      {% for m in marquee limit: 3 %}
        <div class="flex flex--row flex--between flex--center-y w--full">
          <div class="flex flex--row flex--left flex--center-y gap--small">
            <span class="label label--small w--[48px] shrink-0"><strong>{{ m.symbol }}</strong></span>
            <span class="description text--left clamp--1">{{ m.name }}</span>
          </div>
          <span class="label label--small shrink-0">{{ m.day }} {{ m.slot }} &middot; Est {{ m.eps }} &middot; {{ m.mcap_str }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }} &middot; {{ week_range }}</span>
  <span class="instance">{{ summary_line }}</span>
</div>
