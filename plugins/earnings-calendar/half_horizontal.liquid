<div class="layout layout--row flex--top gap--medium lg:gap--large">
  <div class="flex flex--col shrink-0 w--[260px] gap--xsmall">
    <div class="title title--small text--left w--full">{{ week_range }}</div>
    <img src="{{ compact_png }}" alt="Weekly earnings density" class="image image--contain w--[256px] h--[130px]" />
  </div>

  <div class="divider--v"></div>

  <div class="stretch-x text--left grow flex flex--col gap--xsmall">
    <div class="label label--small text--left w--full">TOP WEEKLY REPORTERS (BMO / AMC)</div>
    {% for m in marquee limit: 5 %}
      <div class="flex flex--row flex--between flex--center-y w--full border--b pb--1">
        <div class="flex flex--row flex--left flex--center-y gap--small">
          <span class="label label--small label--inverted px--1">{{ m.symbol }}</span>
          <span class="description text--left clamp--1">{{ m.name }}</span>
        </div>
        <span class="label label--small shrink-0">{{ m.day }} {{ m.slot }} &middot; EPS {{ m.eps }}</span>
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ summary_line }}</span>
</div>
