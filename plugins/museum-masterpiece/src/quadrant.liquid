<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <img src="{{ image_url }}" alt="{{ artwork_title }}" class="image image-dither image--contain w--full h--[64cqh] rounded" />
    <div class="w--full text--left">
      <div class="label label--base text--left"><strong>{{ artwork_title }}</strong></div>
      <div class="label label--small text--left">{{ artist }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
