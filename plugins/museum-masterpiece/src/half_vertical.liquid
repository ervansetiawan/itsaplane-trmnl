<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <div class="flex flex--col flex--center w--full stretch-y">
      <img src="{{ image_url }}" alt="{{ artwork_title }}" class="image image-dither image--contain w--full h--[60cqh] rounded" />
    </div>

    <div class="divider"></div>

    <div class="w--full text--left">
      <div class="title title--small text--left">{{ artwork_title }}</div>
      <div class="description text--left">{{ artist }} &middot; {{ year }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
