<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--large">
    <div class="flex flex--col flex--center w--[56cqw] portrait:w--full h--full">
      <img src="{{ image_url }}" alt="{{ artwork_title }}" class="image image-dither image--contain w--full h--[82cqh] rounded" />
    </div>

    <div class="divider--v portrait:hidden"></div>

    <div class="flex flex--col flex--between stretch-x h--full text--left">
      <div class="w--full">
        <div class="flex flex--row flex--between flex--center-y w--full mb--2">
          <span class="label label--base label--inverted px--2 rounded value--tnums">{{ year | default: "PUBLIC DOMAIN" }}</span>
          {% if gallery != blank %}
            <span class="label label--small value--tnums">GALLERY {{ gallery }}</span>
          {% endif %}
        </div>
        <div class="title title--base lg:title--large text--left mb--1">{{ artwork_title }}</div>
        <div class="title title--small text--left mb--1">{{ artist }}</div>
        {% if artist_bio != blank %}
          <div class="description text--left">{{ artist_bio }}</div>
        {% endif %}
      </div>

      {% if timeline_x != blank %}
        <div class="w--full">
          <div class="label label--small label--underline mb--1 text--left">ART-HISTORY TIMELINE</div>
          <svg viewBox="0 0 200 22" class="w--full">
            <line x1="10" y1="8" x2="190" y2="8" stroke="#000" stroke-width="1.5" />
            <line x1="10" y1="4" x2="10" y2="12" stroke="#000" stroke-width="1.2" />
            <line x1="70" y1="5" x2="70" y2="11" stroke="#000" stroke-width="1" />
            <line x1="130" y1="5" x2="130" y2="11" stroke="#000" stroke-width="1" />
            <line x1="190" y1="4" x2="190" y2="12" stroke="#000" stroke-width="1.2" />
            <circle cx="{{ timeline_x }}" cy="8" r="4" fill="#000" />
            <text x="10" y="20" text-anchor="middle" font-size="6.5" fill="#000" font-family="sans-serif">1400</text>
            <text x="70" y="20" text-anchor="middle" font-size="6.5" fill="#000" font-family="sans-serif">1600</text>
            <text x="130" y="20" text-anchor="middle" font-size="6.5" fill="#000" font-family="sans-serif">1800</text>
            <text x="190" y="20" text-anchor="middle" font-size="6.5" fill="#000" font-family="sans-serif">2000</text>
          </svg>
        </div>
      {% endif %}

      <div class="w--full">
        <div class="divider mb--2"></div>
        <div class="description text--left mb--1"><strong>{{ medium }}</strong>{% if dimensions != blank %} &middot; {{ dimensions }}{% endif %}</div>
        {% if department != blank %}
          <div class="label label--small text--left mb--1">{{ department | upcase }}</div>
        {% endif %}
        {% if credit_line != blank %}
          <div class="description text--left clamp--2 mb--1">{{ credit_line }}</div>
        {% endif %}
        <div class="label label--base text--left">{{ museum }}</div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
