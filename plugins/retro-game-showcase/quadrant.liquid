<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <img src="{{ image_url }}" alt="{{ game_title }}" class="image image-dither image--contain w--full h--[62cqh] rounded" />
    <div class="w--full text--left">
      <div class="description text--left clamp--1"><strong>{{ game_title }}</strong></div>
      <div class="label label--small text--left">{{ platform }} &middot; {{ year }} &middot; {{ developer }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
