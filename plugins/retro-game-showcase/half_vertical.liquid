<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <div class="flex flex--col flex--center w--full stretch-y">
      <img src="{{ image_url }}" alt="{{ game_title }}" class="image image-dither image--contain w--full h--[56cqh] rounded" />
    </div>

    <div class="divider"></div>

    <div class="w--full text--left">
      <div class="flex flex--row flex--between flex--center-y w--full mb--1">
        <span class="label label--small lg:label--large label--inverted px--2 rounded">{{ platform | upcase }} &middot; {{ year }}</span>
        <span class="label label--small lg:label--large">{{ genre | upcase }}</span>
      </div>
      <div class="title title--small lg:title--large text--left mb--1">{{ game_title }}</div>
      <div class="description lg:description--xlarge text--left clamp--2">{{ trivia }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
