<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--large">
    <div class="flex flex--col flex--center w--[52cqw] portrait:w--full h--full portrait:h--auto">
      <img src="{{ image_url }}" alt="{{ game_title }}" class="image image-dither image--contain w--full h--[82cqh] portrait:h--[45cqh] rounded" />
    </div>

    <div class="divider--v portrait:hidden"></div>

    <div class="flex flex--col flex--between stretch-x h--full portrait:h--auto grow gap--small text--left">
      <div class="w--full">
        <div class="flex flex--row flex--between flex--center-y w--full mb--1">
          <span class="label label--base lg:label--large label--inverted px--2 rounded">{{ platform | upcase }} &middot; {{ year }}</span>
          <span class="label label--small lg:label--large">{{ genre | upcase }}</span>
        </div>
        <div class="title title--base lg:title--xlarge text--left mb--1">{{ game_title }}</div>
        <div class="label label--base lg:label--large text--left mb--1">{{ developer }}</div>
        <div class="description lg:description--xlarge text--left clamp--3">{{ description }}</div>
      </div>

      {% if timeline_x != blank %}
        <div class="w--full">
          <div class="label label--small lg:label--large label--underline mb--1 text--left">CONSOLE ERA</div>
          <svg viewBox="0 0 200 22" class="w--full h--[34px] lg:h--[52px]">
            <line x1="10" y1="8" x2="190" y2="8" stroke="#000" stroke-width="1.5" />
            <line x1="10" y1="4" x2="10" y2="12" stroke="#000" stroke-width="1.2" />
            <line x1="82" y1="5" x2="82" y2="11" stroke="#000" stroke-width="1" />
            <line x1="154" y1="5" x2="154" y2="11" stroke="#000" stroke-width="1" />
            <line x1="190" y1="4" x2="190" y2="12" stroke="#000" stroke-width="1.2" />
            <circle cx="{{ timeline_x }}" cy="8" r="4" fill="#000" />
            <text x="10" y="20" text-anchor="middle" font-size="6.5" fill="#000" font-family="sans-serif">1980</text>
            <text x="82" y="20" text-anchor="middle" font-size="6.5" fill="#000" font-family="sans-serif">1990</text>
            <text x="154" y="20" text-anchor="middle" font-size="6.5" fill="#000" font-family="sans-serif">2000</text>
            <text x="190" y="20" text-anchor="middle" font-size="6.5" fill="#000" font-family="sans-serif">2005</text>
          </svg>
        </div>
      {% endif %}

      <div class="w--full">
        <div class="divider mb--1"></div>
        <div class="label label--small lg:label--large label--underline mb--1 text--left">DID YOU KNOW?</div>
        <div class="description lg:description--xlarge text--left clamp--2">{{ trivia }}</div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ platform }} &middot; Libretro &middot; {{ date }}</span>
</div>
