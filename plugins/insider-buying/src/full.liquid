<div class="layout layout--row flex--top portrait:flex--col gap--medium lg:gap--large">
  <div class="flex flex--col shrink-0 w--[268px] lg:w--[280px] portrait:w--full gap--small">
    <div class="label label--small text--left w--full">{{ window_label }}</div>
    <div class="title title--small lg:title--base text--left w--full">{{ total_value }} Bought</div>
    <div class="label label--small text--left w--full">{{ buy_count }} Open-Market Filings &middot; {{ c_suite_count }} C-Suite</div>

    <img src="{{ conviction_png }}" alt="Top insider purchase volume" class="image image--contain w--[264px] h--[196px] portrait:hidden" />
    <img src="{{ mini_conviction_png }}" alt="Top insider purchase volume" class="image image--contain w--[256px] h--[124px] hidden portrait:block" />

    <div class="bg--gray-70 rounded p--2 w--full text--left">
      <div class="label label--small text--left w--full">LARGEST CONVICTION BUY</div>
      <div class="title title--small text--left w--full">{{ lead.ticker }} &middot; {{ lead.value_str }}</div>
      <div class="label label--small text--left w--full clamp--1">{{ lead.insider }} ({{ lead.role }}) @ {{ lead.price }}</div>
    </div>
  </div>

  <div class="divider--v portrait:hidden"></div>

  <div class="stretch-x text--left grow flex flex--col flex--top gap--xsmall">
    <div class="label label--small text--left w--full mb--1">RECENT SEC FORM 4 OPEN-MARKET PURCHASES (CODE P)</div>
    {% for f in filings limit: 6 %}
      <div class="flex flex--row flex--between flex--center-y w--full border--b pb--1">
        <div class="flex flex--col text--left grow">
          <div class="flex flex--row flex--left flex--center-y gap--small">
            <span class="label label--small label--inverted px--1">{{ f.ticker }}</span>
            <span class="description text--left clamp--1"><strong>{{ f.company }}</strong></span>
            <span class="label label--small label--outline px--1">{{ f.role }}</span>
          </div>
          <div class="label label--small text--left mt--1">{{ f.insider }} &middot; Filed {{ f.filing_date }} &middot; {{ f.qty }} shs @ {{ f.price }}</div>
        </div>
        <div class="flex flex--col text--right shrink-0">
          <span class="title title--small text--right">{{ f.value_str }}</span>
          <span class="label label--small text--right">Own {{ f.delta_own }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ summary_line }}</span>
</div>
