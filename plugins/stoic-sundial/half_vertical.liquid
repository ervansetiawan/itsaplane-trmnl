<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <div class="w--full">
      <div class="flex flex--row flex--between flex--center-y w--full mb--1">
        <span class="label label--small label--inverted px--2 rounded">{{ phase | upcase }}</span>
        <span class="label label--small value--tnums">WK {{ current_week }}/52 &middot; {{ year_pct }}%</span>
      </div>
      <svg viewBox="0 0 280 116" class="w--full">
        <path d="M 50,96 A 90,90 0 0 1 230,96" fill="none" stroke="#000" stroke-width="1.5" stroke-dasharray="4 3" />
        <line x1="20" y1="96" x2="260" y2="96" stroke="#000" stroke-width="1.5" />
        <circle cx="{{ sun_x }}" cy="{{ sun_y | minus: 8 }}" r="8" fill="#000" />
      </svg>
    </div>

    <div class="divider"></div>

    <div class="w--full text--left">
      <div class="title title--small text--left mb--1">&ldquo;{{ quote }}&rdquo;</div>
      <div class="description text--left"><strong>&mdash; {{ author }}</strong></div>
    </div>

    <div class="divider"></div>

    <div class="w--full text--left">
      <div class="label label--small label--underline mb--1">CHALLENGE</div>
      <div class="description text--left clamp--2">{{ challenge }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
