<div class="layout layout--col gap--small">
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="label label--small label--inverted px--2">{{ regime }}</span>
    <span class="label label--small">2s10s {{ spread_10_2 }}</span>
  </div>

  <div class="grid grid--cols-2 gap--small w--full">
    <div class="bg--gray-70 rounded p--2 text--left">
      <div class="label label--small text--left">2Y / 10Y</div>
      <div class="title title--small text--left">{{ y2 }} / {{ y10 }}</div>
    </div>
    <div class="bg--gray-70 rounded p--2 text--left">
      <div class="label label--small text--left">3M / 30Y</div>
      <div class="title title--small text--left">{{ y3m }} / {{ y30 }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Yield Curve</span>
  <span class="instance">{{ as_of }}</span>
</div>
