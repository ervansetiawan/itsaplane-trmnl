            <circle cx="{{ q.map_x }}" cy="{{ q.map_y }}" r="{% if q.mag_num >= 5.0 %}3.8{% else %}2.6{% endif %}" fill="#000" stroke="#fff" stroke-width="0.8" />
          {% endfor %}
          {% if featured %}
            <circle cx="{{ featured.map_x }}" cy="{{ featured.map_y }}" r="8" fill="none" stroke="#000" stroke-width="1.2" />
            <circle cx="{{ featured.map_x }}" cy="{{ featured.map_y }}" r="14" fill="none" stroke="#000" stroke-width="1" stroke-dasharray="2,2" />
            <circle cx="{{ featured.map_x }}" cy="{{ featured.map_y }}" r="20" fill="none" stroke="#000" stroke-width="0.8" stroke-dasharray="2,3" />
            <text x="{{ featured.map_x }}" y="{{ featured.map_y | minus: 10 }}" font-size="8" font-weight="700" text-anchor="middle" fill="#000" font-family="sans-serif">M{{ featured.mag }}</text>
          {% endif %}
        </svg>

        {% if featured %}
          <div class="flex flex--row flex--between flex--center-y w--full mt--1">
            <span class="description">
              <span class="label label--small label--inverted px--1">M{{ featured.mag }}</span>
              <strong>{{ featured.place }}</strong>
            </span>
            <span class="label label--base shrink-0">{{ featured.depth_km }}km &middot; {{ featured.time }}</span>
          </div>
        {% endif %}
      </div>

      <div class="divider--v portrait:hidden"></div>

      <div class="flex flex--col flex--between stretch-x text--left">
        <div class="w--full">
          <div class="label label--base label--underline mb--1 text--left">RECENT M4.5+ QUAKES</div>
          {% for item in items limit: 4 %}
            <div class="flex flex--row flex--between flex--center-y w--full mb--1">
              <span class="description text--left"><strong>M{{ item.mag }}</strong> {{ item.place }}</span>
              <span class="label label--small shrink-0">{{ item.time }}</span>
            </div>
          {% endfor %}
        </div>

        <div class="w--full">
          <div class="flex flex--row flex--between flex--center-y mb--1">
            <span class="label label--small label--underline">24H PULSE</span>
            <span class="label label--small">SOLID = M5.0+</span>
          </div>
          <svg viewBox="0 0 240 68" preserveAspectRatio="none" class="w--full h--[46px]">
            <line x1="0" y1="64" x2="240" y2="64" stroke="#000" stroke-width="1" />
            {% for b in hourly_bars %}
              <rect x="{{ b.x }}" y="{{ b.y }}" width="7" height="{{ b.h }}" fill="{% if b.solid %}#000{% else %}#fff{% endif %}" stroke="#000" stroke-width="1" />
            {% endfor %}
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">USGS &middot; {{ date }}</span>
</div>
