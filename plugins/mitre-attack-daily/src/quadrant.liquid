<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <div class="w--full text--left">
      <div class="flex flex--row flex--between flex--center-y w--full mb--1">
        <span class="label label--base label--inverted px--2 rounded value--tnums">{{ technique_id }}</span>
        <span class="label label--small">{{ tactic | upcase }}</span>
      </div>
      <div class="title title--small text--left clamp--2">{{ name }}</div>
    </div>

    <div class="divider"></div>

    <div class="w--full stretch-y text--left">
      <div class="description text--left clamp--3"><strong>Detect:</strong> {{ detection }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
