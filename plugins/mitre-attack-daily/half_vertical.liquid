<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small lg:gap--medium">
    <div class="w--full text--left">
      <div class="flex flex--row flex--between flex--center-y w--full mb--1">
        <span class="label label--base label--inverted px--2 rounded value--tnums">{{ technique_id }}</span>
        <span class="label label--base">{{ tactic | upcase }}</span>
      </div>
      <div class="title title--small lg:title--base text--left mb--1">{{ name }}</div>
      <div class="description text--left clamp--3">{{ description }}</div>
    </div>

    <div class="divider"></div>

    <div class="w--full text--left">
      <div class="label label--base label--underline mb--1 text--left">DETECTION</div>
      <div class="description text--left clamp--3">{{ detection }}</div>
    </div>

    <div class="divider"></div>

    <div class="w--full text--left">
      <div class="label label--base label--underline mb--1 text--left">MITIGATION</div>
      <div class="description text--left clamp--2">{{ mitigation }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
