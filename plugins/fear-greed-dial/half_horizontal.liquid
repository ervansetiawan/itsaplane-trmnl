<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--medium lg:gap--large">
    <div class="flex flex--col flex--center w--[34cqw] shrink-0">
      <svg viewBox="0 0 220 128" class="w--full h--[64cqh]">
        <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#000" stroke-width="10" />
        <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#fff" stroke-width="6" />
        <line x1="110" y1="108" x2="{{ nx }}" y2="{{ ny }}" stroke="#000" stroke-width="3.5" stroke-linecap="round" />
        <circle cx="110" cy="108" r="7" fill="#000" />
      </svg>
      <div class="label label--base"><strong>{{ score }} &middot; {{ rating }}</strong></div>
    </div>

    <div class="flex flex--col flex--between stretch-x h--full text--left">
      <div class="flex flex--row flex--between flex--center-y">
        <span class="title title--base">VIX {{ vix }} ({{ vix_delta }})</span>
        <span class="label label--small">PREV {{ prev_close }}</span>
      </div>
      {% if sparkline != "" %}
        <svg viewBox="0 0 240 60" preserveAspectRatio="none" class="w--full h--[46px]">
          <polyline fill="none" stroke="#000" stroke-width="2" points="{{ sparkline }}" />
        </svg>
      {% endif %}
      <div class="label label--small">1W: {{ one_week }} &middot; 1M: {{ one_month }} &middot; 1Y: {{ one_year }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
