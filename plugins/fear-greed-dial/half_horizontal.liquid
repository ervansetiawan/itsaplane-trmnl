<div class="layout layout--row flex--top gap--medium lg:gap--large">
  <div class="flex flex--col flex--center w--[230px] shrink-0">
    <svg viewBox="0 0 220 128" class="w--[200px] h--[112px]">
      <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#000" stroke-width="10" />
      <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#fff" stroke-width="6" />
      {% for t in dial_ticks %}
        {% if t.major %}
          <line x1="{{ t.x1 }}" y1="{{ t.y1 }}" x2="{{ t.x2 }}" y2="{{ t.y2 }}" stroke="#000" stroke-width="1.8" />
        {% endif %}
      {% endfor %}
      <circle cx="{{ m1_x }}" cy="{{ m1_y }}" r="3.8" fill="#fff" stroke="#000" stroke-width="1.4" />
      <line x1="110" y1="108" x2="{{ nx }}" y2="{{ ny }}" stroke="#000" stroke-width="3.5" stroke-linecap="round" />
      <circle cx="110" cy="108" r="7" fill="#000" />
    </svg>
    <div class="label label--small"><strong>{{ score }} &middot; {{ rating }} ({{ delta_day }})</strong></div>
  </div>

  <div class="divider--v"></div>

  <div class="stretch-x text--left grow flex flex--col gap--xsmall">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="title title--small">VIX {{ vix }} ({{ vix_delta }})</span>
      <span class="label label--small label--inverted px--1">{{ vix_term_regime }}</span>
    </div>
    <div class="label label--small text--left">Term: 9D {{ vix9d }} &middot; 30D {{ vix }} &middot; 3M {{ vix3m }} &middot; P/C {{ put_call_ratio }}</div>
    {% if sparkline != "" %}
      <svg viewBox="0 0 240 60" preserveAspectRatio="none" class="w--full h--[40px]">
        <line x1="0" y1="30" x2="240" y2="30" stroke="#aaa" stroke-width="0.8" stroke-dasharray="2,2" />
        <polyline fill="none" stroke="#000" stroke-width="2" points="{{ sparkline }}" />
      </svg>
    {% endif %}
    <div class="label label--small">Prev {{ prev_close }} &middot; 1W {{ one_week }} &middot; 1M {{ one_month }} &middot; {{ fear_pillars }}/7 Pillars in Fear</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
