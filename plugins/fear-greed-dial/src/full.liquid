<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--large">
    <div class="flex flex--col flex--center w--[46cqw] portrait:w--full">
      <svg viewBox="0 0 220 128" class="w--full h--[48cqh]">
        <!-- Outer semicircular track -->
        <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#000" stroke-width="10" />
        <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#fff" stroke-width="6" />
        <!-- Zone ticks (25, 45, 55, 75) -->
        <line x1="49" y1="47" x2="55" y2="53" stroke="#000" stroke-width="2" />
        <line x1="97" y1="22" x2="97" y2="30" stroke="#000" stroke-width="2" />
        <line x1="123" y1="22" x2="123" y2="30" stroke="#000" stroke-width="2" />
        <line x1="171" y1="47" x2="165" y2="53" stroke="#000" stroke-width="2" />
        <!-- Needle -->
        <line x1="110" y1="108" x2="{{ nx }}" y2="{{ ny }}" stroke="#000" stroke-width="3.5" stroke-linecap="round" />
        <circle cx="110" cy="108" r="7" fill="#000" />
        <circle cx="110" cy="108" r="2.5" fill="#fff" />
        <text x="16" y="122" font-size="8" font-weight="700" text-anchor="start" fill="#000" font-family="sans-serif">0</text>
        <text x="110" y="13" font-size="8" font-weight="700" text-anchor="middle" fill="#000" font-family="sans-serif">50</text>
        <text x="204" y="122" font-size="8" font-weight="700" text-anchor="end" fill="#000" font-family="sans-serif">100</text>
      </svg>

      <div class="value value--large">{{ score }}</div>
      <span class="label label--base label--inverted px--2 mt--1">{{ rating }} ({{ delta_day }})</span>
    </div>

    <div class="divider--v portrait:hidden"></div>

    <div class="flex flex--col flex--between stretch-x h--full text--left">
      <div class="grid grid--cols-2 w--full">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--base lg:value--large">{{ vix }}</span>
            <span class="label label--base">CBOE VIX ({{ vix_delta }})</span>
          </div>
        </div>
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--base lg:value--large">{{ prev_close }}</span>
            <span class="label label--base">Prev Close</span>
          </div>
        </div>
      </div>

      <div class="w--full">
        <div class="divider mb--2"></div>
        <div class="label label--base label--underline mb--1 text--left">HISTORICAL SENTIMENT</div>
        <div class="flex flex--row flex--between w--full mb--1">
          <span class="description">1 Week Ago</span>
          <span class="description"><strong>{{ one_week }}</strong></span>
        </div>
        <div class="flex flex--row flex--between w--full mb--1">
          <span class="description">1 Month Ago</span>
          <span class="description"><strong>{{ one_month }}</strong></span>
        </div>
        <div class="flex flex--row flex--between w--full">
          <span class="description">1 Year Ago</span>
          <span class="description"><strong>{{ one_year }}</strong></span>
        </div>
      </div>

      {% if sparkline != "" %}
        <div class="w--full">
          <div class="divider mb--2"></div>
          <div class="label label--small label--underline mb--1 text--left">30-DAY TREND</div>
          <svg viewBox="0 0 240 60" preserveAspectRatio="none" class="w--full h--[54px]">
            <line x1="0" y1="30" x2="240" y2="30" stroke="#ccc" stroke-width="0.8" stroke-dasharray="2,2" />
            <polyline fill="none" stroke="#000" stroke-width="2" points="{{ sparkline }}" />
          </svg>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">CNN &middot; CBOE &middot; {{ date }}</span>
</div>
