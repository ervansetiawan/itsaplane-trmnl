<div class="layout layout--row flex--top portrait:flex--col gap--medium lg:gap--large">
  <div class="flex flex--col flex--center shrink-0 w--[300px] lg:w--[320px] portrait:w--full gap--xsmall">
    <svg viewBox="0 0 220 128" class="w--[236px] h--[136px]">
      <!-- Outer & inner semicircular gauge tracks -->
      <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#000" stroke-width="11" />
      <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#fff" stroke-width="7" />
      <path d="M 38 108 A 72 72 0 0 1 182 108" fill="none" stroke="#aaa" stroke-width="0.8" stroke-dasharray="2,2" />

      <!-- 5-point degree ticks & major zone dividers -->
      {% for t in dial_ticks %}
        <line x1="{{ t.x1 }}" y1="{{ t.y1 }}" x2="{{ t.x2 }}" y2="{{ t.y2 }}" stroke="#000" stroke-width="{% if t.major %}2{% else %}0.9{% endif %}" />
      {% endfor %}

      <!-- 1M Ago (hollow ring) & 1W Ago (gray dot) ghost markers on arc -->
      <circle cx="{{ m1_x }}" cy="{{ m1_y }}" r="4.2" fill="#fff" stroke="#000" stroke-width="1.5" />
      <circle cx="{{ w1_x }}" cy="{{ w1_y }}" r="3.2" fill="#666" stroke="#000" stroke-width="1" />

      <!-- Active Needle -->
      <line x1="110" y1="108" x2="{{ nx }}" y2="{{ ny }}" stroke="#000" stroke-width="3.8" stroke-linecap="round" />
      <circle cx="110" cy="108" r="7.5" fill="#000" />
      <circle cx="110" cy="108" r="2.8" fill="#fff" />

      <!-- Gauge labels -->
      <text x="14" y="123" font-size="8" font-weight="700" text-anchor="start" fill="#000" font-family="sans-serif">0 FEAR</text>
      <text x="110" y="12" font-size="8" font-weight="700" text-anchor="middle" fill="#000" font-family="sans-serif">50</text>
      <text x="206" y="123" font-size="8" font-weight="700" text-anchor="end" fill="#000" font-family="sans-serif">GREED 100</text>
    </svg>

    <div class="flex flex--row flex--center flex--center-y gap--small">
      <span class="title title--xlarge lg:title--xxlarge">{{ score }}</span>
      <div class="flex flex--col text--left">
        <span class="label label--small label--inverted px--2">{{ rating }} ({{ delta_day }})</span>
        <span class="label label--small mt--1">Prev {{ prev_close }} &middot; 1W {{ one_week }} &middot; 1M {{ one_month }} &middot; 1Y {{ one_year }}</span>
      </div>
    </div>

    {% if sparkline != "" %}
      <div class="w--full mt--1">
        <div class="flex flex--row flex--between flex--center-y w--full mb--1">
          <span class="label label--small">30-DAY SENTIMENT TREND</span>
          <span class="label label--small">Lo {{ min_30d }} &middot; Hi {{ max_30d }}</span>
        </div>
        <svg viewBox="0 0 240 60" preserveAspectRatio="none" class="w--full h--[56px]">
          <line x1="0" y1="17" x2="240" y2="17" stroke="#bbb" stroke-width="0.7" stroke-dasharray="2,2" />
          <line x1="0" y1="30" x2="240" y2="30" stroke="#888" stroke-width="0.9" stroke-dasharray="3,2" />
          <line x1="0" y1="43" x2="240" y2="43" stroke="#bbb" stroke-width="0.7" stroke-dasharray="2,2" />
          {% if spark_area != "" %}
            <polygon fill="#ddd" points="{{ spark_area }}" />
          {% endif %}
          <polyline fill="none" stroke="#000" stroke-width="2.2" points="{{ sparkline }}" />
        </svg>
      </div>
    {% endif %}
  </div>

  <div class="divider--v portrait:hidden"></div>

  <div class="stretch-x text--left grow flex flex--col flex--top gap--small">
    <div class="grid grid--cols-2 gap--small w--full">
      <div class="bg--gray-70 rounded p--2 text--left">
        <div class="flex flex--row flex--between flex--center-y w--full">
          <span class="label label--small">CBOE VIX ({{ vix_delta }})</span>
          <span class="label label--small label--inverted px--1">{{ vix_term_regime }}</span>
        </div>
        <div class="title title--base lg:title--large text--left">{{ vix }}</div>
        <div class="label label--small text--left">9D {{ vix9d }} &middot; 30D {{ vix }} &middot; 3M {{ vix3m }}</div>
      </div>

      <div class="bg--gray-70 rounded p--2 text--left">
        <div class="flex flex--row flex--between flex--center-y w--full">
          <span class="label label--small">OPTIONS &amp; CREDIT</span>
          <span class="label label--small label--outline px--1">{{ fear_pillars }}/7 FEAR</span>
        </div>
        <div class="title title--base lg:title--large text--left">P/C {{ put_call_ratio }}</div>
        <div class="label label--small text--left">HY Spread {{ hy_spread }} &middot; {{ greed_pillars }}/7 Greed</div>
      </div>
    </div>

    <img src="{{ pillars_png }}" alt="7 CNN Fear and Greed sub-indicators" class="image image--contain w--[340px] h--[160px]" />
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">VIX {{ vix }} ({{ vix_term_regime }}) &middot; P/C {{ put_call_ratio }} &middot; {{ date }}</span>
</div>
