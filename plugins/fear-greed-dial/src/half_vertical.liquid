<div class="layout layout--col layout--col--top gap--small">
  <div class="flex flex--col flex--center w--full">
    <svg viewBox="0 0 220 128" class="w--[220px] h--[124px]">
      <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#000" stroke-width="10" />
      <path d="M 24 108 A 86 86 0 0 1 196 108" fill="none" stroke="#fff" stroke-width="6" />
      {% for t in dial_ticks %}
        {% if t.major %}
          <line x1="{{ t.x1 }}" y1="{{ t.y1 }}" x2="{{ t.x2 }}" y2="{{ t.y2 }}" stroke="#000" stroke-width="1.8" />
        {% endif %}
      {% endfor %}
      <circle cx="{{ m1_x }}" cy="{{ m1_y }}" r="3.8" fill="#fff" stroke="#000" stroke-width="1.4" />
      <line x1="110" y1="108" x2="{{ nx }}" y2="{{ ny }}" stroke="#000" stroke-width="3.5" stroke-linecap="round" />
      <circle cx="110" cy="108" r="7" fill="#000" />
    </svg>
    <div class="flex flex--row flex--center flex--center-y gap--small">
      <span class="title title--large">{{ score }}</span>
      <span class="label label--small label--inverted px--2">{{ rating }} ({{ delta_day }})</span>
    </div>
  </div>

  <div class="bg--gray-70 rounded p--2 w--full text--left">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="label label--small"><strong>VIX {{ vix }}</strong> ({{ vix_delta }})</span>
      <span class="label label--small label--inverted px--1">{{ vix_term_regime }}</span>
    </div>
    <div class="label label--small text--left mt--1">9D {{ vix9d }} &middot; 3M {{ vix3m }} &middot; P/C {{ put_call_ratio }} &middot; {{ fear_pillars }}/7 Fear</div>
  </div>

  <div class="label label--small text--left w--full">Prev {{ prev_close }} &middot; 1W {{ one_week }} &middot; 1M {{ one_month }} &middot; 1Y {{ one_year }}</div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
