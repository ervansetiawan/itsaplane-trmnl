<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="title title--small">{{ away_abbr }} {{ away_score }} &ndash; {{ home_score }} {{ home_abbr }}</span>
      <span class="label label--small label--inverted px--1">{{ winner }} WIN</span>
    </div>

    <svg viewBox="0 0 300 100" preserveAspectRatio="none" class="w--full h--[42cqh]">
      <rect x="0.5" y="0.5" width="299" height="99" fill="#fff" stroke="#000" stroke-width="1" />
      <line x1="0" y1="50" x2="300" y2="50" stroke="#999" stroke-width="0.9" stroke-dasharray="3,3" />
      {% if wp_polyline != "" %}
        <polyline fill="none" stroke="#000" stroke-width="2" points="{{ wp_polyline }}" />
      {% endif %}
    </svg>

    {% if mvp %}
      <div class="w--full text--left">
        <div class="divider mb--1"></div>
        <div class="label label--small">GAME MVP</div>
        <div class="description text--left"><strong>{{ mvp.name }}</strong> &mdash; {{ mvp.pts }}P / {{ mvp.reb }}R / {{ mvp.ast }}A</div>
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
