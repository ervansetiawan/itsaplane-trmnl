<div class="layout layout--col gap--small">
  <div class="flex flex--center w--full h--[66cqh] lg:portrait:h--[50cqh] shrink-0">
    <img src="{{ map_data_uri }}" alt="{{ name }}" class="image image-dither image--contain w--full h--full" />
  </div>

  <div class="stretch-x text--left">
    <div class="title title--small lg:title--large text--left">{{ address }}</div>
    <div class="label label--small lg:label--large text--left">{{ name }} &middot; {{ year }}</div>
    <div class="hidden lg:portrait:block description lg:description--xlarge text--left mt--1">{{ story }}</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ city }}</span>
</div>
