<div class="layout layout--col layout--col--top gap--small lg:gap--medium">
  <div class="flex flex--center w--full shrink-0 h--[38cqh] lg:h--[45cqh] lg:portrait:h--[40cqh]">
    <img src="{{ diagram_data_uri }}" alt="{{ name }} airport diagram" class="image image-dither image--contain w--full h--full" />
  </div>

  <div class="stretch-x text--left w--full">
    <div class="flex flex--row flex--left flex--center-y gap--small mb--1">
      <span class="value value--small lg:value--xlarge">{{ iata }}</span>
      <span class="label label--small lg:label--large label--inverted px--2">{{ icao }}</span>
      {% if flt_cat != '' %}
        <span class="label label--small lg:label--large label--outline px--2">{{ flt_cat }}</span>
      {% endif %}
    </div>
    <div class="title title--small lg:title--large text--left">{{ name }}</div>
    <div class="label label--small text--left mb--1">{{ wind }} (RWY {{ active_runway }}) &middot; {{ traffic_count }}</div>

    <div class="bg--gray-70 rounded p--2 w--full text--left">
      <div class="label label--small text--left w--full mb--1"><strong>NEARBY AIRCRAFT ({{ airborne_count }} AIR / {{ ground_count }} GND)</strong></div>
      {% for ac in nearby_aircraft limit: 3 %}
        <div class="flex flex--row flex--between flex--center-y w--full">
          <span class="label label--small"><strong>{{ ac.callsign }}</strong> &middot; {{ ac.type }}</span>
          <span class="label label--small">{{ ac.alt }} &middot; {{ ac.dist }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
