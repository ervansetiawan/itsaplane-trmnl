<div class="layout layout--col gap--small">
  <div class="flex flex--center w--full h--[70cqh] shrink-0">
    <img src="{{ diagram_data_uri }}" alt="{{ name }} airport diagram" class="image w--auto h--full" />
  </div>

  <div class="stretch-x text--left">
    <div class="title title--small text--left">{{ iata }} · {{ name }}</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{% if flt_cat != '' %}{{ flt_cat }} · {% endif %}{{ traffic_count }}</span>
</div>
