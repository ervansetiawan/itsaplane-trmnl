<div class="layout layout--row portrait:flex--col gap--medium">
  <div class="flex flex--center shrink-0">
    <img src="{{ diagram_data_uri }}" alt="{{ name }} airport diagram" class="image w--[432px] h--[324px] portrait:w--full portrait:h--auto" />
  </div>

  <div class="stretch-x text--left">
    <div class="flex flex--row flex--center-y gap--small mb--1">
      <span class="value value--large">{{ iata }}</span>
      <span class="label label--small label--inverted px--2">{{ icao }}</span>
      {% if flt_cat != '' %}
        <span class="label label--small label--outline px--2">{{ flt_cat }}</span>
      {% endif %}
    </div>

    <div class="title title--small text--left">{{ name }}</div>
    <div class="label label--small text--left">{{ city }}, {{ country }} · {{ tagline }}</div>
    <div class="description text--left mt--1 mb--2"><strong>RWY</strong> {{ runways }}</div>

    <div class="divider mb--2"></div>

    <div class="grid grid--cols-2 gap--small mb--2">
      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall">{{ wind }}</span>
          <span class="label label--small">RWY {{ active_runway }} · {{ wind_components }}</span>
        </div>
      </div>

      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall">{% if temp_c != nil %}{{ temp_c }}°C{% else %}--{% endif %}</span>
          <span class="label label--small">{{ ceiling }} · {{ visibility }}</span>
        </div>
      </div>

      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall">{{ traffic_count }}</span>
          <span class="label label--small">{{ closest_flight }}</span>
        </div>
      </div>

      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall">{{ longest_runway }}</span>
          <span class="label label--small">Elev {{ elevation }}</span>
        </div>
      </div>
    </div>

    <div class="flex flex--row flex--between">
      <span class="label label--small">{{ altim }}</span>
      <span class="label label--small">{{ local_time }}</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
