<div class="layout layout--row gap--medium lg:gap--large">
  <div class="flex flex--center shrink-0 w--[40cqw] lg:portrait:w--[50cqw] h--full">
    <img src="{{ diagram_data_uri }}" alt="{{ name }} airport diagram" class="image image-dither image--contain w--full h--full" />
  </div>

  <div class="stretch-x text--left">
    <div class="flex flex--row flex--center-y gap--small mb--1">
      <span class="value value--small lg:value--xlarge">{{ iata }}</span>
      <span class="label label--small lg:label--large label--inverted px--2">{{ icao }}</span>
      {% if flt_cat != '' %}
        <span class="label label--small lg:label--large label--outline px--2">{{ flt_cat }}</span>
      {% endif %}
    </div>
    <div class="title title--small lg:title--large text--left">{{ name }}</div>
    <div class="label label--small lg:label--large text--left mb--1">{{ city }}, {{ country }}</div>
    <div class="description lg:description--xlarge text--left mb--1"><strong>RWY</strong> {{ runways }}</div>
    <div class="label label--small lg:label--large text--left">{{ wind }} ({{ wind_components }}) · {{ traffic_count }}</div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
