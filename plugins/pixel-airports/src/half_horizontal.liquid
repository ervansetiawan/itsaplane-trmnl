<div class="layout layout--row flex--top gap--medium lg:gap--large">
  <div class="flex flex--center shrink-0 w--[40cqw] lg:portrait:w--[50cqw] h--full">
    <img src="{{ diagram_data_uri }}" alt="{{ name }} airport diagram" class="image image-dither image--contain w--full h--full" />
  </div>

  <div class="stretch-x text--left grow flex flex--col gap--xsmall">
    <div class="flex flex--row flex--left flex--center-y gap--small w--full">
      <span class="value value--small lg:value--xlarge">{{ iata }}</span>
      <span class="label label--small lg:label--large label--inverted px--2">{{ icao }}</span>
      {% if flt_cat != '' %}
        <span class="label label--small lg:label--large label--outline px--2">{{ flt_cat }}</span>
      {% endif %}
      <span class="label label--small">{{ wind }} (RWY {{ active_runway }})</span>
    </div>
    <div class="title title--small lg:title--large text--left">{{ name }} &middot; {{ city }}</div>

    <div class="label label--small text--left w--full"><strong>NEARBY ({{ traffic_count }} &middot; {{ airborne_count }} AIR / {{ ground_count }} GND)</strong></div>
    {% for ac in nearby_aircraft limit: 3 %}
      <div class="flex flex--row flex--between flex--center-y w--full border--b pb--1">
        <span class="label label--small"><strong>{{ ac.callsign }}</strong> ({{ ac.type }})</span>
        <span class="label label--small">{{ ac.alt }} &middot; {{ ac.speed }} &middot; {{ ac.dist }}</span>
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
