<div class="layout layout--row portrait:flex--col gap--medium lg:gap--large">
  <div class="flex flex--center shrink-0 lg:w--[54cqw] lg:h--[78cqh] portrait:w--full portrait:h--[42cqh]">
    <img src="{{ diagram_data_uri }}" alt="{{ name }} airport diagram" class="image image-dither image--contain w--[432px] h--[324px] lg:w--full lg:h--full portrait:w--full portrait:h--full" />
  </div>

  <div class="stretch-x text--left">
    <div class="flex flex--row flex--center-y gap--small mb--1">
      <span class="value value--large lg:value--xxlarge">{{ iata }}</span>
      <span class="label label--small lg:label--large label--inverted px--2">{{ icao }}</span>
      {% if flt_cat != '' %}
        <span class="label label--small lg:label--large label--outline px--2">{{ flt_cat }}</span>
      {% endif %}
    </div>

    <div class="title title--small lg:title--large text--left">{{ name }}</div>
    <div class="label label--small lg:label--large text--left">{{ city }}, {{ country }} · {{ tagline }}</div>
    <div class="description lg:description--xlarge text--left mt--1 mb--2"><strong>RWY</strong> {{ runways }}</div>

    <div class="divider mb--2"></div>

    <div class="grid grid--cols-2 gap--small lg:gap--medium mb--2">
      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall lg:value--base">{{ wind }}</span>
          <span class="label label--small lg:label--base">RWY {{ active_runway }} · {{ wind_components }}</span>
        </div>
      </div>

      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall lg:value--base">{% if temp_c != nil %}{{ temp_c }}°C{% else %}--{% endif %}</span>
          <span class="label label--small lg:label--base">{{ ceiling }} · {{ visibility }}</span>
        </div>
      </div>

      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall lg:value--base">{{ traffic_count }}</span>
          <span class="label label--small lg:label--base">{{ closest_flight }}</span>
        </div>
      </div>

      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall lg:value--base">{{ longest_runway }}</span>
          <span class="label label--small lg:label--base">Elev {{ elevation }}</span>
        </div>
      </div>
    </div>

    <div class="flex flex--row flex--between">
      <span class="label label--small lg:label--large">{{ altim }}</span>
      <span class="label label--small lg:label--large">{{ local_time }}</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
