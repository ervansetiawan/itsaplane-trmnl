<div class="layout layout--col gap--small lg:gap--medium">
  <div class="flex flex--center w--full shrink-0 h--[38cqh] lg:h--[45cqh] lg:portrait:h--[40cqh]">
    <img src="{{ diagram_data_uri }}" alt="{{ name }} airport diagram" class="image image--contain w--full h--full" />
  </div>

  <div class="stretch-x text--left">
    <div class="flex flex--row flex--center-y gap--small mb--1">
      <span class="value value--small lg:value--xlarge">{{ iata }}</span>
      <span class="label label--small lg:label--large label--inverted px--2">{{ icao }}</span>
      {% if flt_cat != '' %}
        <span class="label label--small lg:label--large label--outline px--2">{{ flt_cat }}</span>
      {% endif %}
    </div>
    <div class="title title--small lg:title--large text--left">{{ name }}</div>
    <div class="label label--small lg:label--large text--left mb--1">{{ city }}, {{ country }} · {{ tagline }}</div>
    <div class="description lg:description--xlarge text--left mb--2"><strong>RWY</strong> {{ runways }}</div>

    <div class="grid grid--cols-2 lg:portrait:grid--cols-1 gap--small">
      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall lg:value--base">{{ wind }}</span>
          <span class="label label--small lg:label--base">RWY {{ active_runway }} · {{ wind_components }}</span>
        </div>
      </div>
      <div class="item bg--gray-70 rounded p--2">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall lg:value--base">{{ traffic_count }}</span>
          <span class="label label--small lg:label--base">{{ closest_flight }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
