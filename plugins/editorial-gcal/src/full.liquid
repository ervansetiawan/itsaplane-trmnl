<div class="layout layout--row flex--top portrait:flex--col gap--medium lg:gap--large">
  <div class="flex flex--col shrink-0 w--[272px] lg:w--[282px] portrait:w--full gap--xsmall">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <div class="flex flex--row flex--left flex--center-y gap--small">
        <span class="title title--xlarge lg:title--xxlarge text--left">{{ day_num }}</span>
        <div class="flex flex--col text--left">
          <div class="flex flex--row flex--left flex--center-y gap--xsmall">
            <span class="label label--small label--inverted px--2">{{ weekday }}</span>
            <span class="label label--small label--outline px--1">{{ week_badge }}</span>
          </div>
          <span class="label label--small text--left mt--1">{{ month_year }}</span>
        </div>
      </div>
    </div>

    <img src="{{ overview_png }}" alt="Month calendar and day timeline" class="image image--contain w--[268px] h--[256px] portrait:hidden" />
    <img src="{{ daybar_png }}" alt="Day timeline" class="image image--contain w--[260px] h--[58px] hidden portrait:block" />

    <div class="bg--gray-70 rounded p--1 w--full text--left">
      <div class="label label--small text--left w--full">FREE &middot; {{ free_window }}</div>
    </div>
  </div>

  <div class="divider--v portrait:hidden"></div>

  <div class="stretch-x text--left grow flex flex--col flex--top gap--xsmall">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <div class="flex flex--row flex--left flex--center-y gap--xsmall">
        {% if all_day.size > 0 %}
          <span class="label label--small label--inverted px--1">ALL DAY</span>
          {% for ad in all_day limit: 1 %}
            <span class="label label--small"><strong>{{ ad.title }}</strong></span>
          {% endfor %}
        {% else %}
          <span class="label label--small label--inverted px--1">TODAY'S BRIEFING</span>
        {% endif %}
      </div>
      <span class="label label--small">{{ summary_line }}</span>
    </div>

    {% if hero %}
      <div class="bg--gray-70 rounded p--2 w--full text--left">
        <div class="flex flex--row flex--between flex--center-y w--full mb--1">
          <div class="flex flex--row flex--left flex--center-y gap--xsmall">
            <span class="label label--small label--inverted px--2">{{ hero.status }}</span>
            <span class="label label--small"><strong>{{ hero.time_range }}</strong></span>
            <span class="label label--small label--outline px--1">{{ hero.duration }}</span>
          </div>
          <span class="label label--small label--inverted px--1">{{ hero.countdown }}</span>
        </div>
        <div class="title title--small lg:title--base text--left w--full">{{ hero.title }}</div>
        <div class="flex flex--row flex--left flex--center-y gap--xsmall w--full mt--1">
          {% if hero.meet_tag != "" %}
            <span class="label label--small label--outline px--1">{{ hero.meet_tag }}</span>
          {% endif %}
          {% if hero.meta_line != "" %}
            <span class="label label--small">{{ hero.meta_line }}</span>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="label label--small text--left w--full mt--1">TODAY'S TIMELINE</div>
    <div class="flex flex--col gap--xsmall w--full">
      {% for ev in today_events limit: 4 %}
        <div class="flex flex--row flex--between flex--center-y w--full border--b pb--1">
          <div class="flex flex--row flex--left flex--center-y gap--xsmall grow">
            <span class="label label--small w--[60px] shrink-0"><strong>{{ ev.start_short }}</strong></span>
            {% if ev.state == "DONE" %}
              <span class="label label--small label--outline px--1 shrink-0">DONE</span>
            {% else %}
              <span class="label label--small label--inverted px--1 shrink-0">{{ ev.state }}</span>
            {% endif %}
            <span class="description text--left clamp--1"><strong>{{ ev.title }}</strong></span>
          </div>
          <div class="flex flex--row flex--center-y gap--xsmall shrink-0">
            {% if ev.meet_tag != "" %}
              <span class="label label--small label--outline px--1">{{ ev.meet_tag }}</span>
            {% endif %}
            <span class="label label--small">{{ ev.duration }}</span>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if tomorrow_events.size > 0 %}
      <div class="bg--gray-70 rounded p--2 w--full text--left mt--1">
        <div class="flex flex--row flex--between flex--center-y w--full mb--1">
          <span class="label label--small"><strong>TOMORROW &middot; {{ tomorrow_label }}</strong></span>
          <span class="label label--small">{{ tomorrow_events.size }} scheduled</span>
        </div>
        <div class="flex flex--col gap--xsmall w--full">
          {% for tev in tomorrow_events limit: 2 %}
            <div class="flex flex--row flex--between flex--center-y w--full">
              <div class="flex flex--row flex--left flex--center-y gap--small">
                <span class="label label--small w--[60px] shrink-0">{{ tev.start_short }}</span>
                <span class="label label--small text--left clamp--1"><strong>{{ tev.title }}</strong></span>
              </div>
              <span class="label label--small shrink-0">{{ tev.duration }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }} &middot; {{ date_label }}</span>
  <span class="instance">{% if is_demo %}Demo Schedule &middot; {% endif %}Updated {{ now_time }}</span>
</div>
