<div class="layout layout--col">
  <div class="flex flex--row w--full h--full gap--medium lg:gap--large">
    <div class="flex flex--col flex--between w--[36cqw] shrink-0 text--left">
      <div class="text--left w--full">
        <div class="value value--base lg:value--xlarge value--tnums">{{ total_rce }}</div>
        <div class="label label--base lg:label--large text--left">RCE KEVs ({{ recent_30d }} / 30d)</div>
      </div>
      {% if featured %}
        <div class="text--left w--full">
          <div class="divider mb--1"></div>
          <div class="title title--small lg:title--large text--left value--tnums">{{ featured.cve_id }}</div>
          <div class="description lg:description--xlarge text--left clamp--1">{{ featured.vendor }} {{ featured.product }}{% if featured.cvss %} &middot; {{ featured.cvss }}{% endif %}</div>
        </div>
      {% endif %}
    </div>

    <div class="divider--v"></div>

    <div class="text--left stretch-x flex flex--col flex--between">
      <div class="label label--base lg:label--large label--underline mb--1 text--left w--full">EXPLOITED RCEs (CVSS &middot; EPSS)</div>
      <div class="flex flex--col flex--between stretch-y w--full">
        {% for item in items limit: 4 %}
          <div class="flex flex--row flex--between flex--center-y w--full">
            <span class="description lg:description--xlarge text--left clamp--1"><strong>{{ item.cve_id }}</strong> &middot; {{ item.vendor }}</span>
            <span class="label label--base lg:label--large value--tnums shrink-0">{% if item.cvss %}{{ item.cvss }}{% endif %}{% if item.epss %} &middot; {{ item.epss }}{% endif %}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
