<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="value value--base lg:value--xlarge value--tnums">{{ total_rce }} RCE</span>
      <span class="label label--base lg:label--large label--inverted px--2 rounded value--tnums">{{ recent_30d }} IN 30D</span>
    </div>

    {% if featured %}
      <div class="w--full text--left">
        <div class="divider mb--1"></div>
        <div class="title title--small lg:title--large text--left value--tnums">{{ featured.cve_id }}{% if featured.cvss %} &middot; {{ featured.cvss }}{% endif %}</div>
        <div class="description lg:description--xlarge text--left clamp--1">{{ featured.vendor }} {{ featured.product }}</div>
      </div>
    {% endif %}

    <div class="w--full stretch-y text--left flex flex--col flex--between">
      <div class="divider mb--1"></div>
      {% for item in items limit: 2 %}
        <div class="description lg:description--xlarge text--left clamp--1 w--full value--tnums"><strong>{{ item.cve_id }}</strong>{% if item.cvss %} ({{ item.cvss }}){% endif %} &middot; {{ item.vendor }}</div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
