<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--medium">
    <div class="grid grid--cols-4 w--full">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--xlarge value--tnums">{{ total_rce }}</span>
          <span class="label label--base lg:label--large">RCE KEVs</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--xlarge value--tnums">{{ recent_30d }}</span>
          <span class="label label--base lg:label--large">Last 30d</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--xlarge value--tnums">{{ ransomware_count }}</span>
          <span class="label label--base lg:label--large">Ransomware</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--xlarge value--tnums">{{ total_kev }}</span>
          <span class="label label--base lg:label--large">Total KEV</span>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="flex flex--row portrait:flex--col w--full stretch-y gap--large">
      {% if featured %}
        <div class="flex flex--col flex--between w--[44cqw] portrait:w--full portrait:h--auto text--left">
          <div class="text--left w--full">
            <div class="flex flex--row flex--between flex--center-y w--full mb--1">
              <div class="flex flex--row gap--small">
                <span class="label label--base lg:label--large label--inverted px--2 rounded">{{ featured.severity | default: "EXPLOITED" }}</span>
                {% if featured.ransomware %}
                  <span class="label label--base lg:label--large label--inverted px--2 rounded">RANSOMWARE</span>
                {% endif %}
                {% if featured.cwe != blank %}
                  <span class="label label--small lg:label--large label--outline px--1 rounded">{{ featured.cwe }}</span>
                {% endif %}
              </div>
              <span class="label label--small lg:label--large value--tnums">{{ featured.due_label }}</span>
            </div>
            <div class="title title--base lg:title--xlarge text--left mb--1 value--tnums">{{ featured.cve_id }}</div>
            <div class="title title--small lg:title--large text--left mb--1">{{ featured.vendor }} &middot; {{ featured.product }}</div>
            <div class="description lg:description--xlarge text--left clamp--3 mb--2">{{ featured.description }}</div>
            {% if featured.action != blank %}
              <div class="bg--gray-70 rounded p--2 text--left mb--2">
                <div class="label label--small lg:label--large mb--1">REQUIRED ACTION</div>
                <div class="description lg:description--xlarge text--left clamp--2">{{ featured.action }}</div>
              </div>
            {% endif %}
          </div>

          <div class="w--full">
            {% if featured.cvss %}
              <div class="flex flex--row flex--between flex--center-y w--full mb--1">
                <span class="label label--base lg:label--large">CVSS</span>
                <span class="description lg:description--xlarge value--tnums"><strong>{{ featured.cvss }} / 10</strong></span>
              </div>
              <svg viewBox="0 0 100 8" preserveAspectRatio="none" class="w--full h--[8px] lg:h--[12px] mb--1">
                <rect x="0" y="0" width="100" height="8" fill="#fff" stroke="#000" stroke-width="1.2" />
                <rect x="0" y="0" width="{{ featured.cvss_pct }}" height="8" fill="#000" />
                <line x1="40" y1="0" x2="40" y2="8" stroke="#fff" stroke-width="0.8" />
                <line x1="70" y1="0" x2="70" y2="8" stroke="#fff" stroke-width="0.8" />
                <line x1="90" y1="0" x2="90" y2="8" stroke="#fff" stroke-width="0.8" />
              </svg>
            {% endif %}
            {% if featured.epss %}
              <div class="flex flex--row flex--between flex--center-y w--full mb--1">
                <span class="label label--base lg:label--large">EPSS</span>
                <span class="description lg:description--xlarge value--tnums"><strong>{{ featured.epss }}</strong></span>
              </div>
              <svg viewBox="0 0 100 8" preserveAspectRatio="none" class="w--full h--[8px] lg:h--[12px]">
                <rect x="0" y="0" width="100" height="8" fill="#fff" stroke="#000" stroke-width="1.2" />
                <rect x="0" y="0" width="{{ featured.epss_pct }}" height="8" fill="#000" />
                <line x1="25" y1="0" x2="25" y2="8" stroke="#fff" stroke-width="0.8" />
                <line x1="50" y1="0" x2="50" y2="8" stroke="#fff" stroke-width="0.8" />
                <line x1="75" y1="0" x2="75" y2="8" stroke="#fff" stroke-width="0.8" />
              </svg>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="divider--v portrait:hidden"></div>

      <div class="stretch-x text--left flex flex--col flex--between portrait:h--auto grow">
        <div class="w--full">
          {% if monthly_bars.size > 0 %}
            <div class="flex flex--row flex--between flex--center-y w--full mb--1">
              <span class="label label--base lg:label--large label--underline">12M RCE TREND</span>
              <span class="label label--small lg:label--large">SOLID = RANSOMWARE</span>
            </div>
            <svg viewBox="0 0 240 42" preserveAspectRatio="none" class="w--full h--[38px] lg:h--[58px] mb--2">
              <line x1="0" y1="38" x2="240" y2="38" stroke="#000" stroke-width="1" />
              {% for b in monthly_bars %}
                {% if b.h > 0 %}
                  <rect x="{{ b.x }}" y="{{ b.y }}" width="14" height="{{ b.h }}" fill="#fff" stroke="#000" stroke-width="1.2" />
                {% endif %}
                {% if b.rh > 0 %}
                  <rect x="{{ b.x }}" y="{{ b.ry }}" width="14" height="{{ b.rh }}" fill="#000" />
                {% endif %}
              {% endfor %}
            </svg>
          {% endif %}
          <div class="label label--base lg:label--large label--underline mb--1 text--left w--full">RECENT EXPLOITED RCEs</div>
        </div>

        <div class="flex flex--col flex--between stretch-y w--full">
          {% for item in items limit: 3 %}
            <div class="w--full">
              <div class="flex flex--row flex--between flex--center-y w--full mb--1">
                <span class="title title--small lg:title--large text--left clamp--1 value--tnums">{{ item.cve_id }}</span>
                <div class="flex flex--row flex--center-y gap--small shrink-0">
                  {% if item.ransomware %}
                    <span class="label label--small lg:label--large label--inverted px--1 rounded">RW</span>
                  {% endif %}
                  {% if item.cvss %}
                    <span class="label label--base lg:label--large value--tnums">CVSS {{ item.cvss }}</span>
                  {% endif %}
                </div>
              </div>
              <div class="description lg:description--xlarge text--left clamp--1 mb--1"><strong>{{ item.vendor }} {{ item.product }}</strong> &mdash; {{ item.description }}</div>
              {% if item.epss %}
                <div class="flex flex--row flex--center-y gap--small w--full">
                  <span class="label label--small lg:label--large value--tnums shrink-0">EPSS {{ item.epss }}</span>
                  <svg viewBox="0 0 100 6" preserveAspectRatio="none" class="stretch-x h--[6px] lg:h--[10px]">
                    <rect x="0" y="0" width="100" height="6" fill="#fff" stroke="#000" stroke-width="1.2" />
                    <rect x="0" y="0" width="{{ item.epss_pct }}" height="6" fill="#000" />
                  </svg>
                </div>
              {% endif %}
            </div>
            {% unless forloop.last %}
              <div class="divider"></div>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">CISA KEV &middot; {{ date }}</span>
</div>
