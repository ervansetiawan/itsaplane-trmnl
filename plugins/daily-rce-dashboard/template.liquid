<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--medium">
    <div class="grid grid--cols-4 w--full">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--large value--tnums">{{ total_rce }}</span>
          <span class="label label--base">RCE KEVs</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--large value--tnums">{{ recent_30d }}</span>
          <span class="label label--base">Last 30d</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--large value--tnums">{{ ransomware_count }}</span>
          <span class="label label--base">Ransomware</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--large value--tnums">{{ total_kev }}</span>
          <span class="label label--base">Total KEV</span>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="flex flex--row portrait:flex--col w--full stretch-y gap--large">
      {% if featured %}
        <div class="flex flex--col flex--between w--[44cqw] portrait:w--full text--left">
          <div class="text--left w--full">
            <div class="flex flex--row flex--between flex--center-y w--full mb--1">
              <div class="flex flex--row gap--small">
                <span class="label label--base label--inverted px--2 rounded">{{ featured.severity | default: "EXPLOITED" }}</span>
                {% if featured.ransomware %}
                  <span class="label label--base label--inverted px--2 rounded">RANSOMWARE</span>
                {% endif %}
              </div>
              <span class="label label--base value--tnums">DUE {{ featured.due_date }}</span>
            </div>
            <div class="title title--base lg:title--large text--left mb--1 value--tnums">{{ featured.cve_id }}</div>
            <div class="title title--small text--left mb--2">{{ featured.vendor }} &middot; {{ featured.product }}</div>
            <div class="description text--left clamp--3">{{ featured.description }}</div>
          </div>

          <div class="w--full mt--2">
            {% if featured.cvss %}
              <div class="flex flex--row flex--between flex--center-y w--full mb--1">
                <span class="label label--base">CVSS</span>
                <span class="description value--tnums"><strong>{{ featured.cvss }} / 10</strong></span>
              </div>
              <svg viewBox="0 0 100 8" preserveAspectRatio="none" class="w--full h--[8px] mb--2">
                <rect x="0" y="0" width="100" height="8" fill="#fff" stroke="#000" stroke-width="1.2" />
                <rect x="0" y="0" width="{{ featured.cvss_pct }}" height="8" fill="#000" />
                <line x1="40" y1="0" x2="40" y2="8" stroke="#fff" stroke-width="0.8" />
                <line x1="70" y1="0" x2="70" y2="8" stroke="#fff" stroke-width="0.8" />
                <line x1="90" y1="0" x2="90" y2="8" stroke="#fff" stroke-width="0.8" />
              </svg>
            {% endif %}
            {% if featured.epss %}
              <div class="flex flex--row flex--between flex--center-y w--full mb--1">
                <span class="label label--base">EPSS</span>
                <span class="description value--tnums"><strong>{{ featured.epss }}</strong></span>
              </div>
              <svg viewBox="0 0 100 8" preserveAspectRatio="none" class="w--full h--[8px]">
                <rect x="0" y="0" width="100" height="8" fill="#fff" stroke="#000" stroke-width="1.2" />
                <rect x="0" y="0" width="{{ featured.epss_pct }}" height="8" fill="#000" />
                <line x1="25" y1="0" x2="25" y2="8" stroke="#fff" stroke-width="0.8" />
                <line x1="50" y1="0" x2="50" y2="8" stroke="#fff" stroke-width="0.8" />
                <line x1="75" y1="0" x2="75" y2="8" stroke="#fff" stroke-width="0.8" />
              </svg>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="divider--v portrait:hidden"></div>

      <div class="stretch-x text--left flex flex--col flex--between">
        <div class="label label--base label--underline mb--2 text--left w--full">RECENT EXPLOITED RCEs</div>
        <div class="flex flex--col flex--between stretch-y w--full">
          {% for item in items limit: 3 %}
            <div class="w--full">
              <div class="flex flex--row flex--between flex--center-y w--full mb--1">
                <span class="title title--small text--left clamp--1 value--tnums">{{ item.cve_id }}</span>
                <div class="flex flex--row flex--center-y gap--small shrink-0">
                  {% if item.ransomware %}
                    <span class="label label--small label--inverted px--1 rounded">RW</span>
                  {% endif %}
                  {% if item.cvss %}
                    <span class="label label--base value--tnums">CVSS {{ item.cvss }}</span>
                  {% endif %}
                </div>
              </div>
              <div class="description text--left clamp--1 mb--1"><strong>{{ item.vendor }} {{ item.product }}</strong> &mdash; {{ item.description }}</div>
              {% if item.epss %}
                <div class="flex flex--row flex--center-y gap--small w--full">
                  <span class="label label--base value--tnums shrink-0">EPSS {{ item.epss }}</span>
                  <svg viewBox="0 0 100 6" preserveAspectRatio="none" class="stretch-x h--[6px]">
                    <rect x="0" y="0" width="100" height="6" fill="#fff" stroke="#000" stroke-width="1.2" />
                    <rect x="0" y="0" width="{{ item.epss_pct }}" height="6" fill="#000" />
                  </svg>
                </div>
              {% endif %}
            </div>
            {% unless forloop.last %}
              <div class="divider"></div>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">CISA KEV &middot; {{ date }}</span>
</div>
