<style>
  .cw-q-body {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    width: 100%;
    height: 100%;
  }

  .cw-q-grid {
    display: grid;
    grid-template-columns: repeat(5, 28px);
    grid-template-rows: repeat(5, 28px);
    border: 2px solid #000;
    flex-shrink: 0;
  }

  .cw-q-cell {
    position: relative;
    border: 1px solid #000;
    background: #fff;
    box-sizing: border-box;
  }

  .cw-q-cell.black {
    background: #000;
  }

  .cw-q-num {
    position: absolute;
    top: 1px;
    left: 2px;
    font-size: 8px;
    font-weight: 700;
    line-height: 1;
  }

  .cw-q-clues {
    flex: 1;
    overflow: hidden;
  }

  .cw-q-clues h3 {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    margin: 4px 0 2px 0;
  }

  .cw-q-item {
    font-size: 10px;
    line-height: 1.2;
    margin-bottom: 2px;
  }
</style>

<div class="layout layout--col">
  <div class="cw-q-body">
    <div class="cw-q-grid">
      {% for row in grid %}
        {% for cell in row %}
          <div class="cw-q-cell {% if cell.black %}black{% endif %}">
            {% if cell.number %}<span class="cw-q-num">{{ cell.number }}</span>{% endif %}
          </div>
        {% endfor %}
      {% endfor %}
    </div>

    <div class="cw-q-clues">
      <h3>Across</h3>
      {% for item in across %}
        <div class="cw-q-item"><strong>{{ item.number }}.</strong> {{ item.clue }}</div>
      {% endfor %}
      <h3>Down</h3>
      {% for item in down %}
        <div class="cw-q-item"><strong>{{ item.number }}.</strong> {{ item.clue }}</div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
