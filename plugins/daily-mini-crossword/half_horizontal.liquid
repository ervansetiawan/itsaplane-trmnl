<style>
  .cw-hh-body {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16px;
    width: 100%;
    height: 100%;
  }

  .cw-hh-grid {
    display: grid;
    grid-template-columns: repeat(5, 34px);
    grid-template-rows: repeat(5, 34px);
    border: 2px solid #000;
    flex-shrink: 0;
  }

  .cw-hh-cell {
    position: relative;
    border: 1px solid #000;
    background: #fff;
    box-sizing: border-box;
  }

  .cw-hh-cell.black {
    background: #000;
  }

  .cw-hh-num {
    position: absolute;
    top: 1px;
    left: 2px;
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
  }

  .cw-hh-clues {
    display: flex;
    gap: 14px;
    flex: 1;
    overflow: hidden;
  }

  .cw-hh-group {
    flex: 1;
  }

  .cw-hh-group h3 {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    margin: 0 0 4px 0;
  }

  .cw-hh-item {
    font-size: 11px;
    line-height: 1.25;
    margin-bottom: 3px;
  }
</style>

<div class="layout layout--col">
  <div class="cw-hh-body">
    <div class="cw-hh-grid">
      {% for row in grid %}
        {% for cell in row %}
          <div class="cw-hh-cell {% if cell.black %}black{% endif %}">
            {% if cell.number %}<span class="cw-hh-num">{{ cell.number }}</span>{% endif %}
          </div>
        {% endfor %}
      {% endfor %}
    </div>

    <div class="cw-hh-clues">
      <div class="cw-hh-group">
        <h3>Across</h3>
        {% for item in across %}
          <div class="cw-hh-item"><strong>{{ item.number }}.</strong> {{ item.clue }}</div>
        {% endfor %}
      </div>
      <div class="cw-hh-group">
        <h3>Down</h3>
        {% for item in down %}
          <div class="cw-hh-item"><strong>{{ item.number }}.</strong> {{ item.clue }}</div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
