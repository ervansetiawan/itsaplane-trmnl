<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col flex--center-y w--full h--full gap--medium lg:gap--large">
    <table border="1" cellspacing="0" cellpadding="2" class="w--[22cqw] h--[90cqh] shrink-0">
      {% for row in grid %}
        <tr>
          {% for cell in row %}
            <td width="20%" height="20%" valign="top" align="left" class="{% if cell.black %}bg--black{% else %}bg--white{% endif %}">
              {% if cell.number %}
                <span class="label label--small">{{ cell.number }}</span>
              {% endif %}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    </table>

    <div class="flex flex--row portrait:flex--col gap--medium lg:gap--large stretch-x">
      <div class="text--left stretch-x">
        <div class="label label--small label--underline mb--1 text--left">ACROSS</div>
        {% for item in across %}
          <div class="description text--left mb--1"><strong>{{ item.number }}.</strong> {{ item.clue }}</div>
        {% endfor %}
      </div>
      <div class="text--left stretch-x">
        <div class="label label--small label--underline mb--1 text--left">DOWN</div>
        {% for item in down %}
          <div class="description text--left mb--1"><strong>{{ item.number }}.</strong> {{ item.clue }}</div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
