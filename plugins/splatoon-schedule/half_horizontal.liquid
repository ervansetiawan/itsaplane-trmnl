<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    {% if turf %}
      <div class="grid grid--cols-2 gap--medium w--full stretch-y">
        {% for s in turf.stages %}
          <div class="flex flex--col flex--center w--full">
            <img src="{{ s.image_url }}" alt="{{ s.name }}" class="image image-dither image--contain w--full h--[54cqh] rounded mb--1" />
            <div class="description text--center clamp--1"><strong>{{ s.name }}</strong></div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    <div class="divider"></div>
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="label label--small label--inverted px--2 rounded">TURF WAR</span>
      {% if series %}<span class="description clamp--1"><strong>Series ({{ series.rule }}):</strong> {{ series.stages[0].name }} / {{ series.stages[1].name }}</span>{% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
