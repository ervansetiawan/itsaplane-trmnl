<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    {% if turf %}
      <div class="flex flex--row flex--between flex--center-y w--full">
        <span class="label label--small label--inverted px--2 rounded">TURF WAR</span>
        <span class="label label--small value--tnums">{{ turf.window }}</span>
      </div>
      {% for s in turf.stages %}
        <div class="w--full">
          <img src="{{ s.image_url }}" alt="{{ s.name }}" class="image image-dither image--contain w--full h--[24cqh] rounded mb--1" />
          <div class="description text--center clamp--1"><strong>{{ s.name }}</strong></div>
        </div>
      {% endfor %}
    {% endif %}
    {% if series %}
      <div class="divider"></div>
      <div class="description text--left clamp--2"><strong>Series ({{ series.rule }}):</strong> {{ series.stages[0].name }} &amp; {{ series.stages[1].name }}</div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
