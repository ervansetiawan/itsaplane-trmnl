<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="value value--small">{{ critical_count }} CRIT</span>
      <span class="label label--small">{{ bgp_count }} BGP</span>
    </div>

    {% if featured %}
      <div class="w--full text--left">
        <div class="divider mb--1"></div>
        <div class="label label--small text--left"><strong>{{ featured.name }}</strong></div>
        <div class="description text--left">-{{ featured.drop_pct }}% ({{ featured.datasource }})</div>
      </div>
    {% endif %}

    <div class="w--full stretch-y text--left">
      <div class="divider mb--1"></div>
      {% for item in items limit: 2 %}
        <div class="description text--left"><strong>{{ item.name }}</strong> -{{ item.drop_pct }}%</div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
