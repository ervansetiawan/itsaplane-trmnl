<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--medium lg:gap--large">
    <div class="flex flex--col flex--between w--[34cqw] shrink-0 text--left">
      <div class="text--left">
        <div class="value value--small lg:value--base">{{ critical_count }}</div>
        <div class="label label--small text--left">Critical ({{ bgp_count }} BGP)</div>
      </div>
      {% if featured %}
        <div class="text--left">
          <div class="divider mb--1"></div>
          <div class="label label--small text--left"><strong>{{ featured.name }}</strong></div>
          <div class="description text--left">-{{ featured.drop_pct }}% ({{ featured.datasource }})</div>
        </div>
      {% endif %}
    </div>

    <div class="text--left stretch-x">
      <div class="label label--small label--underline mb--1 text--left">TOP OUTAGES</div>
      {% for item in items limit: 4 %}
        <div class="flex flex--row flex--between flex--center-y mb--1">
          <span class="description text--left"><strong>{{ item.name }}</strong></span>
          <span class="label label--small shrink-0">-{{ item.drop_pct }}% &middot; {{ item.datasource }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
