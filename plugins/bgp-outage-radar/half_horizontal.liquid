<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--medium lg:gap--large">
    <div class="flex flex--col flex--between w--[34cqw] portrait:w--full shrink-0 text--left">
      <div class="text--left w--full">
        <div class="value value--base lg:value--large value--tnums">{{ critical_count }}</div>
        <div class="label label--small text--left">Critical ({{ bgp_count }} BGP)</div>
      </div>
      {% if featured %}
        <div class="text--left w--full">
          <div class="divider mb--1"></div>
          <div class="description text--left clamp--1"><strong>{{ featured.name }}</strong></div>
          <div class="label label--small text--left value--tnums">-{{ featured.drop_pct }}% ({{ featured.datasource }})</div>
        </div>
      {% endif %}
    </div>

    <div class="divider--v portrait:hidden"></div>

    <div class="text--left stretch-x flex flex--col flex--between">
      <div class="label label--base label--underline mb--1 text--left w--full">TOP OUTAGES</div>
      <div class="flex flex--col flex--between stretch-y w--full">
        {% for item in items limit: 4 %}
          <div class="flex flex--row flex--between flex--center-y w--full">
            <span class="description text--left clamp--1"><strong>{{ item.name }}</strong></span>
            <span class="label label--small shrink-0 value--tnums">-{{ item.drop_pct }}% &middot; {{ item.datasource }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
