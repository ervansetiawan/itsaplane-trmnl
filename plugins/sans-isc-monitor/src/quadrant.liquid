<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="label label--base label--inverted px--2 rounded">INFOCON: {{ infocon }}</span>
      <span class="label label--small value--tnums">{{ total_records_fmt }} REPORTS</span>
    </div>

    <div class="divider"></div>

    <div class="flex flex--col flex--between stretch-y w--full text--left">
      {% for p in top_ports limit: 3 %}
        <div class="flex flex--row flex--center-y gap--small w--full">
          <span class="description w--[26cqw] shrink-0 value--tnums"><strong>{{ p.port }}</strong> {{ p.service }}</span>
          <svg viewBox="0 0 100 8" preserveAspectRatio="none" class="stretch-x h--[8px]">
            <rect x="0" y="0" width="100" height="8" fill="#fff" stroke="#000" stroke-width="1" />
            <rect x="0" y="0" width="{{ p.bar_pct }}" height="8" fill="#000" />
          </svg>
          <span class="label label--small shrink-0 value--tnums">{{ p.records_fmt }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
