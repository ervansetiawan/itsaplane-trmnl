<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--medium">
    <div class="grid grid--cols-4 w--full">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--large">{{ infocon }}</span>
          <span class="label label--base">InfoCon</span>
        </div>
      </div>

      <div class="item">
        <div class="meta"></div>
        <div class="content">
          {% if top_port %}
            <span class="value value--base lg:value--large value--tnums">{{ top_port.port }}</span>
            <span class="label label--base">#1 {{ top_port.service }}</span>
          {% else %}
            <span class="value value--base lg:value--large">&mdash;</span>
            <span class="label label--base">Top Port</span>
          {% endif %}
        </div>
      </div>

      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--large value--tnums">{{ total_records_fmt }}</span>
          <span class="label label--base">Reports</span>
        </div>
      </div>

      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--base lg:value--large value--tnums">{{ total_targets_fmt }}</span>
          <span class="label label--base">Targets</span>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="flex flex--col flex--between stretch-y w--full">
      <div class="flex flex--row flex--between flex--center-y w--full mb--1">
        <span class="label label--base label--underline">TOP ATTACKED PORTS</span>
        <span class="label label--small">RECORDS &middot; SOURCES</span>
      </div>

      <div class="flex flex--col flex--between stretch-y w--full gap--small">
        {% for p in top_ports limit: 6 %}
          <div class="flex flex--row flex--center-y gap--medium w--full">
            <div class="w--[20cqw] shrink-0 text--left">
              <span class="description value--tnums"><strong>{{ p.port }}</strong> {{ p.service }}</span>
            </div>
            <svg viewBox="0 0 100 10" preserveAspectRatio="none" class="stretch-x h--[12px]">
              <rect x="0" y="0" width="100" height="10" fill="#fff" stroke="#000" stroke-width="1" />
              <rect x="0" y="0" width="{{ p.bar_pct }}" height="10" fill="#000" />
            </svg>
            <div class="w--[20cqw] shrink-0 text--right">
              <span class="label label--base value--tnums">{{ p.records_fmt }} &middot; {{ p.sources_fmt }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">DShield &middot; {{ date }}</span>
</div>
