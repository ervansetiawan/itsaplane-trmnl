<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--large">
    <div class="flex flex--col flex--center shrink-0 portrait:h--auto">
      <svg viewBox="-8 -8 316 316" class="w--[46cqw] h--[84cqh] portrait:w--[70cqw] portrait:h--[40cqh]">
        <!-- Astrolabe outer bezel & zodiac ticks -->
        <circle cx="150" cy="150" r="144" fill="none" stroke="#000" stroke-width="1.4" />
        <circle cx="150" cy="150" r="136" fill="none" stroke="#000" stroke-width="0.6" />
        <line x1="6" y1="150" x2="294" y2="150" stroke="#ccc" stroke-width="0.6" stroke-dasharray="2,3" />
        <line x1="150" y1="6" x2="150" y2="294" stroke="#ccc" stroke-width="0.6" stroke-dasharray="2,3" />
        {% for t in bezel_ticks %}
          <line x1="{{ t.x1 }}" y1="{{ t.y1 }}" x2="{{ t.x2 }}" y2="{{ t.y2 }}" stroke="#000" stroke-width="{% if t.major %}1.1{% else %}0.6{% endif %}" />
        {% endfor %}
        {% for z in zodiac_sectors %}
          <text x="{{ z.x }}" y="{{ z.y }}" font-size="7" font-weight="700" text-anchor="middle" fill="#000" font-family="sans-serif">{{ z.label }}</text>
        {% endfor %}

        <!-- Concentric orbits & asteroid belt -->
        <circle cx="150" cy="150" r="90" fill="none" stroke="#888" stroke-width="1.2" stroke-dasharray="1,3" />
        {% for p in planets %}
          <circle cx="150" cy="150" r="{{ p.orbit_r }}" fill="none" stroke="#000" stroke-width="0.7" stroke-dasharray="2,2" />
        {% endfor %}

        <!-- Earth-Mars sightline -->
        <line x1="{{ earth_cx }}" y1="{{ earth_cy }}" x2="{{ mars_cx }}" y2="{{ mars_cy }}" stroke="#555" stroke-width="0.8" stroke-dasharray="3,2" />

        <!-- Sunburst -->
        {% for r in sun_rays %}
          <line x1="{{ r.x1 }}" y1="{{ r.y1 }}" x2="{{ r.x2 }}" y2="{{ r.y2 }}" stroke="#000" stroke-width="1.1" />
        {% endfor %}
        <circle cx="150" cy="150" r="7" fill="#000" />
        <circle cx="150" cy="150" r="10.5" fill="none" stroke="#000" stroke-width="0.8" />

        <!-- Planets -->
        {% for p in planets %}
          {% if p.is_saturn %}
            <ellipse cx="{{ p.cx }}" cy="{{ p.cy }}" rx="10" ry="3.4" fill="none" stroke="#000" stroke-width="1.3" transform="rotate(-22 {{ p.cx }} {{ p.cy }})" />
          {% endif %}
          {% if p.is_earth %}
            <circle cx="{{ p.cx }}" cy="{{ p.cy }}" r="7" fill="none" stroke="#000" stroke-width="0.9" />
          {% endif %}
          {% if p.abbr == "JUP" %}
            <circle cx="{{ p.cx | minus: 9 }}" cy="{{ p.cy }}" r="1" fill="#000" />
            <circle cx="{{ p.cx | plus: 9 }}" cy="{{ p.cy }}" r="1" fill="#000" />
          {% endif %}
          <circle cx="{{ p.cx }}" cy="{{ p.cy }}" r="{{ p.dot_r }}" fill="#000" stroke="#fff" stroke-width="1" />
          <text x="{{ p.lx }}" y="{{ p.ly }}" font-size="9" font-weight="700" text-anchor="middle" fill="#000" font-family="sans-serif">{{ p.abbr }}</text>
        {% endfor %}
      </svg>
    </div>

    <div class="flex flex--col flex--between stretch-x h--full portrait:h--auto grow text--left">
      <div class="w--full">
        <div class="flex flex--row flex--between flex--center-y mb--2">
          <span class="label label--base lg:label--large label--inverted px--2">J2000 EPHEMERIS</span>
          <span class="label label--base lg:label--large">DAY {{ day_of_year }} &middot; {{ moon_phase | upcase }} ({{ moon_illum }}%)</span>
        </div>

        <div class="grid grid--cols-2 gap--small w--full mb--2">
          <div class="item bg--gray-70 rounded p--2">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--base lg:value--xlarge">{{ earth_mars_au }}</span>
              <span class="label label--base lg:label--large">Earth–Mars ({{ earth_mars_mkm }})</span>
            </div>
          </div>
          <div class="item bg--gray-70 rounded p--2">
            <div class="meta"></div>
            <div class="content">
              <span class="value value--base lg:value--xlarge">{{ earth_venus_au }}</span>
              <span class="label label--base lg:label--large">Earth–Venus ({{ earth_venus_mkm }})</span>
            </div>
          </div>
        </div>
      </div>

      <div class="w--full stretch-y">
        <div class="divider mb--2"></div>
        <div class="label label--base lg:label--large label--underline mb--2 text--left">HELIOCENTRIC POSITIONS</div>
        {% for p in planets %}
          <div class="flex flex--row flex--between flex--center-y w--full mb--1">
            <span class="title title--small lg:title--large text--left">{{ p.name }} ({{ p.abbr }})</span>
            <span class="description lg:description--xlarge shrink-0 value--tnums">{{ p.lon }} &middot; {{ p.zodiac }} &middot; {{ p.au }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
