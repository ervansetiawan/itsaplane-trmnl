<div class="layout layout--col">
  <div class="flex flex--col flex--between w--full h--full gap--small lg:gap--medium">
    <div class="flex flex--col flex--center w--full grow">
      <svg viewBox="0 0 300 300" class="w--[78cqw] grow">
        <circle cx="150" cy="150" r="144" fill="none" stroke="#000" stroke-width="1.3" />
        <circle cx="150" cy="150" r="90" fill="none" stroke="#888" stroke-width="1" stroke-dasharray="1,3" />
        {% for p in planets %}
          <circle cx="150" cy="150" r="{{ p.orbit_r }}" fill="none" stroke="#000" stroke-width="0.7" stroke-dasharray="2,2" />
        {% endfor %}
        <line x1="{{ earth_cx }}" y1="{{ earth_cy }}" x2="{{ mars_cx }}" y2="{{ mars_cy }}" stroke="#555" stroke-width="0.8" stroke-dasharray="3,2" />
        <circle cx="150" cy="150" r="7" fill="#000" />
        {% for p in planets %}
          {% if p.is_saturn %}
            <ellipse cx="{{ p.cx }}" cy="{{ p.cy }}" rx="9" ry="3.2" fill="none" stroke="#000" stroke-width="1.2" transform="rotate(-22 {{ p.cx }} {{ p.cy }})" />
          {% endif %}
          <circle cx="{{ p.cx }}" cy="{{ p.cy }}" r="{{ p.dot_r }}" fill="#000" stroke="#fff" stroke-width="1" />
          <text x="{{ p.lx }}" y="{{ p.ly }}" font-size="7" font-weight="700" text-anchor="middle" fill="#000" font-family="sans-serif">{{ p.abbr }}</text>
        {% endfor %}
      </svg>
    </div>

    <div class="divider"></div>

    <div class="w--full text--left">
      <div class="flex flex--row flex--between mb--1">
        <span class="label label--small lg:label--large"><strong>MARS:</strong> {{ earth_mars_au }}</span>
        <span class="label label--small lg:label--large">{{ moon_phase }} ({{ moon_illum }}%)</span>
      </div>
      <div class="description lg:description--xlarge">
        {% for p in planets %}{{ p.abbr }} {{ p.lon }}{% unless forloop.last %} &middot; {% endunless %}{% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
