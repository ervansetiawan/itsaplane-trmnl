<div class="layout layout--col">
  <div class="flex flex--row flex--center-y w--full h--full gap--small lg:gap--medium">
    <svg viewBox="0 0 300 300" class="w--[48cqw] h--[86cqh] shrink-0">
      <circle cx="150" cy="150" r="144" fill="none" stroke="#000" stroke-width="1.3" />
      <circle cx="150" cy="150" r="90" fill="none" stroke="#888" stroke-width="1" stroke-dasharray="1,3" />
      {% for p in planets %}
        <circle cx="150" cy="150" r="{{ p.orbit_r }}" fill="none" stroke="#000" stroke-width="0.7" stroke-dasharray="2,2" />
      {% endfor %}
      <circle cx="150" cy="150" r="7" fill="#000" />
      {% for p in planets %}
        {% if p.is_saturn %}
          <ellipse cx="{{ p.cx }}" cy="{{ p.cy }}" rx="9" ry="3.2" fill="none" stroke="#000" stroke-width="1.2" transform="rotate(-22 {{ p.cx }} {{ p.cy }})" />
        {% endif %}
        <circle cx="{{ p.cx }}" cy="{{ p.cy }}" r="{{ p.dot_r }}" fill="#000" stroke="#fff" stroke-width="1" />
      {% endfor %}
    </svg>

    <div class="flex flex--col flex--between stretch-x h--full text--left">
      <span class="label label--small lg:label--large label--inverted px--2">DAY {{ day_of_year }}</span>
      <div class="description lg:description--xlarge"><strong>MARS</strong><br/>{{ earth_mars_au }}</div>
      <div class="description lg:description--xlarge"><strong>VENUS</strong><br/>{{ earth_venus_au }}</div>
      <div class="label label--small lg:label--large">{{ moon_phase }}</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
