<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col w--full h--full gap--large">
    <div class="flex flex--col flex--center shrink-0">
      <svg viewBox="0 0 276 276" class="w--[44cqw] h--[82cqh] portrait:w--[76cqw]">
        <rect x="1" y="1" width="274" height="274" rx="4" fill="#fff" stroke="#000" stroke-width="2" />
        {% for tile in tiles %}
          {% assign col = forloop.index0 | modulo: 3 %}
          {% assign row = forloop.index0 | divided_by: 3 %}
          {% assign tx = col | times: 88 | plus: 10 %}
          {% assign ty = row | times: 88 | plus: 10 %}
          <rect x="{{ tx }}" y="{{ ty }}" width="80" height="80" rx="3" fill="#fff" stroke="#000" stroke-width="1.2" />
          <g transform="translate({{ tx }}, {{ ty }})">{{ tile }}</g>
        {% endfor %}
        <rect x="186" y="186" width="80" height="80" rx="3" fill="#000" />
        <text x="226" y="242" text-anchor="middle" font-size="44" font-weight="700" fill="#fff" font-family="sans-serif">?</text>
      </svg>
    </div>

    <div class="divider--v portrait:hidden"></div>

    <div class="flex flex--col flex--between stretch-x h--full text--left">
      <div class="w--full">
        <div class="flex flex--row flex--between flex--center-y w--full mb--1">
          <span class="label label--base label--inverted px--2 rounded">{{ category | upcase }}</span>
          <span class="label label--small">{{ difficulty | upcase }}</span>
        </div>
        <div class="label label--base label--underline mb--2 text--left w--full">FIND THE MISSING TILE (?)</div>

        <div class="grid grid--cols-2 gap--medium w--full">
          {% for opt in choices %}
            <div class="flex flex--row flex--center-y gap--small">
              <span class="label label--base label--inverted px--2 rounded shrink-0">{{ opt.label }}</span>
              <svg viewBox="0 0 80 80" class="w--[64px] h--[64px] shrink-0">
                <rect x="1" y="1" width="78" height="78" rx="3" fill="#fff" stroke="#000" stroke-width="1.5" />
                {{ opt.svg }}
              </svg>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if yesterday %}
        <div class="w--full">
          <div class="divider mb--2"></div>
          <div class="flex flex--row flex--between flex--center-y w--full mb--1">
            <span class="label label--small label--underline">YESTERDAY'S SOLUTION</span>
            <span class="label label--small label--inverted px--2 rounded">ANSWER: {{ yesterday.answer }}</span>
          </div>
          <div class="description text--left">{{ yesterday.explanation }}</div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">Puzzle #{{ puzzle_num }} &middot; {{ date }}</span>
</div>
