<div class="layout layout--row flex--top gap--medium lg:gap--large">
  <div class="flex flex--col shrink-0 w--[260px] gap--xsmall">
    <img src="{{ mini_rotation_png }}" alt="S&P 500 sector relative strength" class="image image--contain w--[256px] h--[134px]" />
  </div>

  <div class="divider--v"></div>

  <div class="stretch-x text--left grow flex flex--col gap--xsmall">
    <div class="flex flex--row flex--left flex--center-y gap--small w--full">
      <span class="label label--small label--inverted px--2">{{ regime }}</span>
      <span class="label label--small">SPY 1M {{ spy.m1_str }}</span>
    </div>
    {% for s in leaders %}
      <div class="flex flex--row flex--between flex--center-y w--full border--b pb--1">
        <span class="label label--small"><strong>{{ s.symbol }}</strong> {{ s.name }}</span>
        <span class="label label--small">1M {{ s.m1_str }} (RS {{ s.rs_m1_str }})</span>
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ breadth_summary }}</span>
</div>
