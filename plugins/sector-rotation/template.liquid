<div class="layout layout--row flex--top portrait:flex--col gap--medium lg:gap--large">
  <div class="flex flex--col shrink-0 w--[342px] lg:w--[352px] portrait:w--full gap--small">
    <div class="flex flex--row flex--left flex--center-y gap--small w--full">
      <span class="label label--small label--inverted px--2">{{ regime }}</span>
      <span class="label label--small">SPY 1M {{ spy.m1_str }}</span>
    </div>

    <img src="{{ rotation_png }}" alt="S&P 500 sector relative strength" class="image image--contain w--[336px] h--[246px] portrait:hidden" />
    <img src="{{ mini_rotation_png }}" alt="S&P 500 sector relative strength" class="image image--contain w--[256px] h--[134px] hidden portrait:block" />

    <div class="label label--small text--left w--full">{{ breadth_summary }}</div>
  </div>

  <div class="divider--v portrait:hidden"></div>

  <div class="stretch-x text--left grow flex flex--col flex--top gap--small">
    <div class="bg--gray-70 rounded p--2 w--full text--left">
      <div class="label label--small text--left w--full">CYCLE REGIME BRIEFING</div>
      <div class="description text--left w--full">{{ regime_note }}</div>
    </div>

    <div class="label label--small text--left w--full">TOP 3 CYCLE LEADERS (1W / 1M / 3M)</div>
    <div class="flex flex--col gap--xsmall w--full">
      {% for s in leaders %}
        <div class="flex flex--row flex--between flex--center-y w--full border--b pb--1">
          <div class="flex flex--row flex--left flex--center-y gap--small">
            <span class="label label--small label--inverted px--1">{{ s.symbol }}</span>
            <span class="description text--left clamp--1"><strong>{{ s.name }}</strong></span>
          </div>
          <span class="label label--small shrink-0">{{ s.w1_str }} &middot; <strong>{{ s.m1_str }}</strong> &middot; {{ s.m3_str }}</span>
        </div>
      {% endfor %}
    </div>

    <div class="label label--small text--left w--full mt--1">BOTTOM 3 LAGGARDS (1W / 1M / 3M)</div>
    <div class="flex flex--col gap--xsmall w--full">
      {% for s in laggards %}
        <div class="flex flex--row flex--between flex--center-y w--full border--b pb--1">
          <div class="flex flex--row flex--left flex--center-y gap--small">
            <span class="label label--small label--outline px--1">{{ s.symbol }}</span>
            <span class="description text--left clamp--1">{{ s.name }}</span>
          </div>
          <span class="label label--small shrink-0">{{ s.w1_str }} &middot; <strong>{{ s.m1_str }}</strong> &middot; {{ s.m3_str }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">SPY 1W {{ spy.w1_str }} &middot; 1M {{ spy.m1_str }} &middot; 3M {{ spy.m3_str }}</span>
</div>
